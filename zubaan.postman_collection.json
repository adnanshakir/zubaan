    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Create Onboarding User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response.userId) {",
                  "    pm.collectionVariables.set('userId', response.userId);",
                  "}",
                  "if (response.recommendedLesson && response.recommendedLesson.id) {",
                  "    pm.collectionVariables.set('lessonId', response.recommendedLesson.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nativeLanguage\": \"hi\",\n  \"goal\": \"interviews\",\n  \"level\": \"elementary\",\n  \"name\": \"Asha\"\n}"
            },
            "url": {
