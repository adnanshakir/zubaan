    {
      "name": "Conversations",
      "item": [
        {
          "name": "Start Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('Conversation has AI opening message', function () {",
                  "    pm.expect(response.messages).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(response.messages[0]).to.have.property('audioUrl');",
                  "});",
                  "",
                  "if (response.conversationId) {",
                  "    pm.collectionVariables.set('conversationId', response.conversationId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
